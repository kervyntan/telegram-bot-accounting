# Environment variables for Telegram Invoice Bot

# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Business Details
BUSINESS_NAME=Your Business Name
BUSINESS_ADDRESS=Your Business Address
