# Environment variables for Telegram Invoice Bot

# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal/group chat ID for automated reports (optional)
# Do NOT use the bot ID from the token prefix.
TELEGRAM_CHAT_ID=

# Webhook URL (set to your deployed Vercel URL, leave empty for local polling)
# Example: https://your-app.vercel.app/api/webhook
WEBHOOK_URL=

# ── Catalogue Bot (public card search bot) ──────────────────────────────────
# Create a second bot via @BotFather and paste its token here
CATALOGUE_BOT_TOKEN=
# Your Telegram chat ID — receive silent notifications when users search
OWNER_CHAT_ID=
# Your Telegram username (without @) — shown as DM button on search results
OWNER_USERNAME=
# Comma-separated chat IDs of the groups/channels whose messages should be indexed
# Example: CATALOGUE_GROUP_IDS=-1001234567890,-1009876543210
CATALOGUE_GROUP_IDS=
# Webhook URL for the catalogue bot endpoint
# Example: https://your-app.vercel.app/api/catalogue_webhook
CATALOGUE_WEBHOOK_URL=

# Business Details
BUSINESS_NAME=Your Business Name
BUSINESS_ADDRESS=Your Business Address
BUSINESS_PHONE=+65 1234 5678
BUSINESS_EMAIL=contact@yourbusiness.com
BUSINESS_REGISTRATION=

# GST Configuration (Singapore)
GST_RATE=0.09
GST_THRESHOLD=400.00
